# Copy to .env (git-ignored) and run: node --env-file=.env scripts/kernel-account.mjs --send
# Pimlico dashboard -> API Keys -> Create. Free tier covers Base Sepolia.
PIMLICO_API_KEY=
# Optional: override the public RPCs used by the probe and account scripts
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
