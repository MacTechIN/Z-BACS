{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-BACS Spike",
  "version": "0.0.1",
  "identifier": "dev.zbacs.spike.assoc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Z-BACS file association spike",
        "width": 760,
        "height": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zbacs"
        ],
        "name": "Z-BACS Sealed File",
        "description": "File sealed with Z-BACS; opening asks the owner for approval",
        "mimeType": "application/x-zbacs",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Utility",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/zbacs.desktop",
        "files": {
          "/usr/share/mime/packages/zbacs.xml": "linux/zbacs.xml"
        }
      }
    }
  }
}
