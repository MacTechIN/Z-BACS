{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Z-BACS design tokens. Source of truth: docs/design/ (D-GO Vault UI kit = default theme 'vault'; Foundations A-olive = alternate theme 'olive'). Regenerate tokens.css from this file.",
  "vault": {
    "color": {
      "brand": {
        "primary": {
          "$type": "color",
          "$value": "#007AFF",
          "$description": "Primary / OK actions, active states"
        },
        "secondary": {
          "$type": "color",
          "$value": "#0F123B",
          "$description": "Secondary / dark-mode primary button, headings"
        }
      },
      "state": {
        "open": {
          "$type": "color",
          "$value": "#F6AD55",
          "$description": "Vault open / session active (warning-orange)"
        },
        "close": {
          "$type": "color",
          "$value": "#27AE60",
          "$description": "Vault closed / sealed / success"
        },
        "sub": {
          "$type": "color",
          "$value": "#AEB9E1",
          "$description": "Waiting / disabled / secondary"
        },
        "error": {
          "$type": "color",
          "$value": "#EB5757"
        }
      },
      "neutral": {
        "black1": {
          "$type": "color",
          "$value": "#000000"
        },
        "black2": {
          "$type": "color",
          "$value": "#434343"
        },
        "white": {
          "$type": "color",
          "$value": "#FFFFFF"
        }
      },
      "tag": {
        "app": {
          "$type": "color",
          "$value": "#1F3FBF",
          "$description": "approx. from kit (App chip)"
        },
        "system": {
          "$type": "color",
          "$value": "#2F3E8F",
          "$description": "approx. from kit (System chip)"
        },
        "files": {
          "$type": "color",
          "$value": "#1E6B3A",
          "$description": "approx. from kit (Files chip)"
        }
      }
    },
    "gradient": {
      "yellow": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #FFFFFF 0%, #FCEFE2 100%)"
      },
      "red": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #FFFFFF 0%, #F6C5C5 100%)"
      },
      "green": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #FFFFFF 0%, #C7F0E3 100%)"
      },
      "purple": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #FFFFFF 0%, #D6DBF2 100%)"
      },
      "background-dark": {
        "$type": "gradient",
        "$value": "linear-gradient(160deg, #04061A 0%, #0F123B 100%)",
        "$description": "Dark mode app background"
      },
      "process": {
        "$type": "gradient",
        "$value": "linear-gradient(135deg, #007AFF 0%, #00E5A8 100%)",
        "$description": "Progress ring, shield-check icon"
      },
      "button-ok": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #00A3FF 0%, #007AFF 100%)"
      },
      "button-error": {
        "$type": "gradient",
        "$value": "linear-gradient(90deg, #EB5757 0%, #F07C7C 100%)"
      }
    },
    "font": {
      "family": {
        "latin": {
          "$type": "fontFamily",
          "$value": [
            "Plus Jakarta Sans",
            "Pretendard",
            "system-ui",
            "sans-serif"
          ]
        },
        "korean": {
          "$type": "fontFamily",
          "$value": [
            "Pretendard",
            "Plus Jakarta Sans",
            "system-ui",
            "sans-serif"
          ],
          "$description": "Kit specifies Plus Jakarta Sans (Google Fonts); Korean glyphs fall back to Pretendard"
        }
      },
      "heading": {
        "h1": {
          "$type": "typography",
          "$value": {
            "fontSize": "38px",
            "fontWeight": 700,
            "lineHeight": 1.2
          }
        },
        "h2": {
          "$type": "typography",
          "$value": {
            "fontSize": "30px",
            "fontWeight": 700,
            "lineHeight": 1.25
          }
        },
        "h3": {
          "$type": "typography",
          "$value": {
            "fontSize": "27px",
            "fontWeight": 700,
            "lineHeight": 1.25
          }
        },
        "h4": {
          "$type": "typography",
          "$value": {
            "fontSize": "26px",
            "fontWeight": 600,
            "lineHeight": 1.3
          }
        },
        "h5": {
          "$type": "typography",
          "$value": {
            "fontSize": "22px",
            "fontWeight": 600,
            "lineHeight": 1.3
          }
        }
      },
      "body": {
        "xl-semibold": {
          "$type": "typography",
          "$value": {
            "fontSize": "24px",
            "fontWeight": 600,
            "lineHeight": 1.4
          }
        },
        "lg-semibold": {
          "$type": "typography",
          "$value": {
            "fontSize": "22px",
            "fontWeight": 600,
            "lineHeight": 1.4
          }
        },
        "lg": {
          "$type": "typography",
          "$value": {
            "fontSize": "20px",
            "fontWeight": 400,
            "lineHeight": 1.5
          }
        },
        "md": {
          "$type": "typography",
          "$value": {
            "fontSize": "18px",
            "fontWeight": 400,
            "lineHeight": 1.5
          }
        },
        "md-medium": {
          "$type": "typography",
          "$value": {
            "fontSize": "18px",
            "fontWeight": 500,
            "lineHeight": 1.5
          }
        },
        "sm-semibold": {
          "$type": "typography",
          "$value": {
            "fontSize": "16px",
            "fontWeight": 600,
            "lineHeight": 1.5
          }
        },
        "sm": {
          "$type": "typography",
          "$value": {
            "fontSize": "16px",
            "fontWeight": 400,
            "lineHeight": 1.5
          }
        }
      }
    },
    "radius": {
      "button": {
        "$type": "dimension",
        "$value": "12px"
      },
      "card": {
        "$type": "dimension",
        "$value": "16px"
      },
      "chip": {
        "$type": "dimension",
        "$value": "999px"
      },
      "key": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "keypad key"
      },
      "icon-button": {
        "$type": "dimension",
        "$value": "999px"
      }
    },
    "size": {
      "touch-min": {
        "$type": "dimension",
        "$value": "44px"
      },
      "keypad-key": {
        "$type": "dimension",
        "$value": "96px"
      },
      "icon-sm": {
        "$type": "dimension",
        "$value": "20px"
      },
      "icon-md": {
        "$type": "dimension",
        "$value": "24px"
      },
      "icon-lg": {
        "$type": "dimension",
        "$value": "40px"
      }
    },
    "motion": {
      "vault-open-close": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Cross-fade opacity between open and closed vault images"
      },
      "key-press": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Keypad key highlight on press"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    },
    "component": {
      "button": {
        "primary-dark": {
          "bg": "{vault.color.brand.secondary}",
          "fg": "{vault.color.neutral.white}",
          "border": "#3A3F6B"
        },
        "primary-light": {
          "bg": "{vault.color.neutral.white}",
          "fg": "{vault.color.brand.secondary}",
          "border": "#C9CFEA"
        },
        "ok": {
          "bg": "{vault.gradient.button-ok}",
          "fg": "{vault.color.neutral.white}"
        },
        "error-dark": {
          "bg": "{vault.gradient.button-error}",
          "fg": "{vault.color.neutral.white}"
        },
        "error-light": {
          "bg": "#FBE9E9",
          "fg": "{vault.color.state.error}",
          "border": "#F3B5B5"
        }
      },
      "toggle": {
        "open": {
          "track": "{vault.color.state.open}"
        },
        "close": {
          "track": "{vault.color.state.close}"
        }
      },
      "status-tag": {
        "error": {
          "bg": "#FBE9E9",
          "fg": "{vault.color.state.error}",
          "border": "#F3B5B5"
        },
        "success": {
          "bg": "#E6F7EC",
          "fg": "{vault.color.state.close}",
          "border": "#B8E8C8"
        },
        "open": {
          "bg": "#FFF4E5",
          "fg": "{vault.color.state.open}",
          "border": "#F9D9A8"
        },
        "closed": {
          "bg": "#E6F7EC",
          "fg": "{vault.color.state.close}",
          "border": "#B8E8C8"
        },
        "waiting": {
          "bg": "#F0F2FA",
          "fg": "{vault.color.state.sub}",
          "border": "#D3D9F0"
        }
      },
      "keypad": {
        "dark": {
          "bg": "{vault.gradient.background-dark}",
          "key-bg": "rgba(255,255,255,0.06)",
          "key-border": "rgba(255,255,255,0.35)",
          "key-pressed": "rgba(255,255,255,0.18)",
          "accent-border": "#2FD8B4"
        },
        "light": {
          "bg": "{vault.color.neutral.white}",
          "key-bg": "#F2F2F2",
          "key-border": "#E3E3E3",
          "key-pressed": "#FFFFFF",
          "accent-border": "#2FD8B4",
          "accent-bg": "#E9FBF4"
        }
      }
    },
    "spacing": {
      "scale": {
        "$type": "dimension",
        "$value": [
          "4px",
          "8px",
          "12px",
          "16px",
          "24px",
          "32px"
        ]
      }
    },
    "$comment_spacing": "4px-based scale shared with the olive theme; UI may only use these steps (ui_guideline §rule 1)"
  },
  "olive": {
    "$description": "Foundations (A안 올리브) — 워크그래피AI brand foundation. Alternate theme, not default. Illustration-first, kraft paper + earth tones.",
    "color": {
      "primary": {
        "$type": "color",
        "$value": "#566B2C",
        "$description": "Olive (Primary)"
      },
      "primary-deep": {
        "$type": "color",
        "$value": "#3F5220"
      },
      "ochre": {
        "$type": "color",
        "$value": "#D4922E"
      },
      "clay": {
        "$type": "color",
        "$value": "#B06B4E"
      },
      "clay-deep": {
        "$type": "color",
        "$value": "#8F4F32"
      },
      "lilac-fill": {
        "$type": "color",
        "$value": "#E2DCEA",
        "$description": "선택 채움"
      },
      "selected-line": {
        "$type": "color",
        "$value": "#6C5CA6",
        "$description": "선택 선"
      },
      "surface": {
        "$type": "color",
        "$value": "#F4F1E9",
        "$description": "Kraft Paper"
      },
      "surface-tint": {
        "$type": "color",
        "$value": "#F1E7DD"
      },
      "ink": {
        "$type": "color",
        "$value": "#33291F"
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#6E6152"
      },
      "border": {
        "$type": "color",
        "$value": "#E4DCCC"
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "success": {
        "$type": "color",
        "$value": "#2F6B32"
      },
      "warning": {
        "$type": "color",
        "$value": "#D4922E"
      },
      "error": {
        "$type": "color",
        "$value": "#B23A2E"
      },
      "ci-purple": {
        "$type": "color",
        "$value": "#6048D8",
        "$description": "퍼플넷 CI, 로고 전용"
      },
      "aux": {
        "clay-line": {
          "$type": "color",
          "$value": "#E6CBBD"
        },
        "success-bg": {
          "$type": "color",
          "$value": "#ECF1EA"
        },
        "skeleton": {
          "$type": "color",
          "$value": "#EAE5DD"
        },
        "warning-bg": {
          "$type": "color",
          "$value": "#F8EDD8"
        },
        "warning-line": {
          "$type": "color",
          "$value": "#E8D4A0"
        },
        "warning-icon": {
          "$type": "color",
          "$value": "#7A5410"
        },
        "warning-text": {
          "$type": "color",
          "$value": "#7A5410"
        },
        "board-bg": {
          "$type": "color",
          "$value": "#E4E3DF"
        }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Pretendard",
          "Noto Sans KR",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$type": "typography",
        "$value": {
          "fontSize": "32px",
          "fontWeight": 700
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontSize": "24px",
          "fontWeight": 700
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontSize": "20px",
          "fontWeight": 700
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontSize": "16px",
          "fontWeight": 500
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontSize": "13px",
          "fontWeight": 500
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontSize": "12px",
          "fontWeight": 500
        }
      }
    },
    "radius": {
      "card": {
        "$type": "dimension",
        "$value": "14px"
      },
      "chip": {
        "$type": "dimension",
        "$value": "100px"
      },
      "screen": {
        "$type": "dimension",
        "$value": "30px"
      },
      "input-underline": {
        "$type": "dimension",
        "$value": "0px"
      }
    },
    "spacing": {
      "scale": {
        "$type": "dimension",
        "$value": [
          "4px",
          "8px",
          "12px",
          "16px",
          "24px",
          "32px"
        ]
      }
    },
    "breakpoint": {
      "$value": [
        "360px",
        "390px",
        "412px",
        "768px",
        "1440px"
      ],
      "$description": "모바일 390 우선"
    },
    "icon": {
      "set": {
        "$value": "lucide"
      }
    },
    "touch-min": {
      "$type": "dimension",
      "$value": "44px"
    }
  }
}
